# Copy to .env and adjust. Never commit a filled-in .env.
# Every variable is optional; the defaults shown run a local SQLite setup.

# --- Django ---
# Required whenever DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Only applied when DJANGO_DEBUG is off:
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=0
DJANGO_TIME_ZONE=UTC

# --- Database (defaults to SQLite at ./db.sqlite3) ---
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# --- Celery (only needed for `import_poi --async`) ---
CELERY_BROKER_URL=amqp://localhost:5672//
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=0
